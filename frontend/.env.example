# AWS: from `sam deploy` outputs (backend/template.yaml -> Outputs)
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
NEXT_PUBLIC_WS_URL=wss://yyyyyyyyyy.execute-api.us-east-1.amazonaws.com/dev

# Local backend (scripts/local_server.py): use same-origin paths instead. Next.js
# proxies them (next.config.ts), so only port 3000 needs to be reachable/forwarded.
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_WS_URL=/ws
# Optional, where the Next server reaches the local backend (these are the defaults):
# API_INTERNAL_URL=http://127.0.0.1:8000
# WS_INTERNAL_URL=http://127.0.0.1:8001
# Extra hostnames allowed to load `next dev` assets (tunnels + LAN IPs are already allowed):
# DEV_ORIGINS=my-tunnel.example.com

# Real accounts (stack outputs UserPoolId / UserPoolClientId). Leave unset to use the backend's dev login.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
